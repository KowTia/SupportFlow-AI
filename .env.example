# Application
APP_NAME=SupportFlow AI
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database & Queue
DATABASE_URL=postgresql+asyncpg://supportflow:supportflow@localhost:5432/supportflow
REDIS_URL=redis://localhost:6379/0

# LLM Router (mock | openai | ollama)
LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDER=mock
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_REPAIR_RETRIES=2
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Outbound Integrations
WEBHOOK_TARGET_URL=https://example.com/webhooks/supportflow
WEBHOOK_HMAC_SECRET=super-secret-hmac-key-change-me
WEBHOOK_DRY_RUN=true
GOOGLE_SHEETS_DRY_RUN=true
GOOGLE_SHEETS_SPREADSHEET_ID=demo-spreadsheet-id
GOOGLE_SHEETS_CREDENTIALS_JSON=
